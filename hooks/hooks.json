{
  "description": "Collaborative Canvas workflow automation hooks",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_collaborative-canvas_canvas__open_canvas",
        "hooks": [{
          "type": "command",
          "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/open-canvas-choice.js",
          "timeout": 10000
        }]
      },
      {
        "matcher": "mcp__plugin_collaborative-canvas_canvas__save_canvas",
        "hooks": [{
          "type": "command",
          "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/save-canvas-listen.js",
          "timeout": 10000
        }]
      },
      {
        "matcher": "mcp__plugin_collaborative-canvas_canvas__get_canvas_state",
        "hooks": [{
          "type": "command",
          "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/get-canvas-state-decision.js",
          "timeout": 10000
        }]
      }
    ]
  }
}
